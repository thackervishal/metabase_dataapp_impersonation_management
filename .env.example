# Copy to .env, add your Metabase license token, then `docker compose up -d`.
# Everything else here is a local demo value that works as it is. The stack only listens on
# localhost, so none of these passwords protect anything real.

# --- Metabase app-db ---
MB_APP_DB_NAME=metabaseappdb
MB_APP_DB_USER=metabase
MB_APP_DB_PASSWORD=metabot1

# --- Sample DWH (the warehouse the RBAC data app manages) ---
SAMPLE_DWH_DB=sample_dwh
# Superuser used only to bootstrap the DB and own the privileged trigger functions.
SAMPLE_DWH_SUPERUSER_PASSWORD=metabot1
# Least-privilege role Metabase's own DB connection uses (SELECT on views, INSERT on command tables only).
SAMPLE_DWH_METABASE_ROLE_PASSWORD=metabot1

# --- Metabase ---
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=metabot1
# The admin API key. Metabase creates it on first boot from this value. It is a demo key that only
# works on your own machine; the app's build tools use the copy in DATA_APP_MB_API_KEY below.
# If you change it, keep the mb_ prefix and use only letters, numbers, +, / and =. Metabase refuses to
# start with any other character (an underscore, for example).
MB_AUTOMATION_API_KEY=mb_LocalDemoAutomationKeyNotASecret0123456789ab=
MB_SITE_NAME="RBAC Data App Demo"

# The only value you have to fill in. It needs the :data-apps-preview entitlement to unlock data apps.
MB_PREMIUM_EMBEDDING_TOKEN=replace-with-your-metabase-token

# --- Data app build tools (npm run dev / npm run build, in data_apps/app-fine-grained-access) ---
# They read this file. Keep the API key the same as MB_AUTOMATION_API_KEY above.
DATA_APP_MB_URL=http://localhost:3000
DATA_APP_MB_API_KEY=mb_LocalDemoAutomationKeyNotASecret0123456789ab=

# Ports
APP_DB_PORT=5434
SAMPLE_DWH_PORT=5433
METABASE_PORT=3000

# Metabase image tag. v1.64.x floats on the latest 1.64 build (run `docker compose pull metabase` to update); pin e.g. v1.64.0.2-beta to freeze.
MB_IMAGE_TAG=v1.64.x
